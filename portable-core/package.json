{
  "name": "@local/weflow-portable-core",
  "version": "0.1.0",
  "private": true,
  "description": "Portable local SDK for reading and exporting WeChat data with optional voice transcription",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "weflow-core": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "resources",
    "README.md",
    "NOTICE.md",
    "LICENSE.upstream.txt"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "smoke": "node -e \"const m=require('./dist'); if(typeof m.WeFlowCore!=='function') process.exit(1); console.log('portable core loaded')\"",
    "ui": "node ui/server.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "koffi": "^3.1.0",
    "sherpa-onnx-node": "^1.13.3",
    "silk-wasm": "^3.7.1",
    "wechat-emojis": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
